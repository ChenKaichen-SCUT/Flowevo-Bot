        "latex2sympy2_extended==1.10.2",
        "lighteval[math]; extra == \"inference\"",
        "pytest; extra == \"test\"",
        "ruff; extra == \"format\"",
        "math-verify[test]; extra == \"dev\"",
        "math-verify[format]; extra == \"dev\"",
        "latex2sympy2_extended[antlr4_9_3]; extra == \"antlr4-9-3\"",
        "latex2sympy2_extended[antlr4_11_0]; extra == \"antlr4-11-0\"",
        "latex2sympy2_extended[antlr4_13_2]; extra == \"antlr4-13-2\""
      ],
      "license_files": [
        "math_verify-0.8.0.dist-info/licenses/LICENCE"
      ]
    },
    {
      "name": "sympy",
      "version": "1.14.0",
      "license": "BSD",
      "requires": [
        "mpmath<1.4,>=1.1.0",
        "pytest>=7.1.0; extra == \"dev\"",
        "hypothesis>=6.70.0; extra == \"dev\""
      ],
      "license_files": [
        "sympy-1.14.0.dist-info/licenses/AUTHORS",
        "sympy-1.14.0.dist-info/licenses/LICENSE",
        "sympy/parsing/latex/LICENSE.txt"
      ]
    },
    {
      "name": "latex2sympy2_extended",
      "version": "1.10.2",
      "license": "MIT",
      "requires": [
        "sympy",
        "antlr4-python3-runtime<=4.13.2,>=4.9.3",
        "pytest; extra == \"dev\"",
        "antlr4-python3-runtime==4.9.3; extra == \"antlr4-9-3\"",
        "antlr4-python3-runtime==4.11.0; extra == \"antlr4-11-0\"",
        "antlr4-python3-runtime==4.13.2; extra == \"antlr4-13-2\""
      ],
      "license_files": [
        "latex2sympy2_extended-1.10.2.dist-info/licenses/LICENSE.txt"
      ]
