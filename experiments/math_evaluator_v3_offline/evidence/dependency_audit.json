      "name": "antlr4-python3-runtime",
      "version": "4.13.2",
      "license": "BSD",
      "requires": [
        "typing ; python_version < \"3.5\""
      ],
      "license_files": []
    },
    {
      "name": "mpmath",
      "version": "1.3.0",
      "license": "BSD",
      "requires": [
        "pytest (>=4.6) ; extra == 'develop'",
        "pycodestyle ; extra == 'develop'",
        "pytest-cov ; extra == 'develop'",
